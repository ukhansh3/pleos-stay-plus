{
  "name": "pleos-stay-plus-parking-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:openapi": "node scripts/validate-openapi.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
