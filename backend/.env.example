# Copy this file to .env for local development. Never commit real credentials.
PARKING_PROVIDER_API_KEY=your_public_data_portal_key
PARKING_PROVIDER_BASE_URL=https://api.data.go.kr/openapi/tn_pubr_prkplce_info_api

# Optional: enable only after activating the official rest-area API.
REST_AREA_PROVIDER_API_KEY=your_public_data_portal_rest_area_key
REST_AREA_PROVIDER_BASE_URL=https://api.data.go.kr/openapi/tn_pubr_public_rest_area_api

PARKING_API_HOST=127.0.0.1
PARKING_API_PORT=3000
PARKING_CACHE_TTL_HOURS=24
PARKING_STALE_MAX_DAYS=7
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_backend_secret_key
PUBLIC_WEB_BASE_URL=http://localhost:3001
# Generate a separate random value of at least 32 characters. Never commit it.
PICKUP_INVITATION_HMAC_SECRET=your_separate_random_invitation_secret
# Explicit local-only adapter. The server refuses this mode on non-loopback hosts.
PICKUP_DEV_MODE=false
# Leave unset until measurement/approval; automatic proximity remains disabled.
PICKUP_PROXIMITY_MAX_ACCURACY_METERS=
PICKUP_PROXIMITY_MAX_AGE_SECONDS=
