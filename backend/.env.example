# Copy this file to .env for local development. Never commit real credentials.
PARKING_PROVIDER_API_KEY=your_public_data_portal_key
PARKING_PROVIDER_BASE_URL=https://api.data.go.kr/openapi/tn_pubr_prkplce_info_api

# Optional: enable only after activating the official rest-area API.
REST_AREA_PROVIDER_API_KEY=your_public_data_portal_rest_area_key
REST_AREA_PROVIDER_BASE_URL=https://api.data.go.kr/openapi/tn_pubr_public_rest_area_api

PARKING_API_HOST=127.0.0.1
PARKING_API_PORT=3000
PARKING_CACHE_TTL_HOURS=24
PARKING_STALE_MAX_DAYS=7
