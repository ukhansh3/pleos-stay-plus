<Window x:Class="StayPlus.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Stay+ · 파일 전송"
        Width="960" Height="800" MinWidth="610" MinHeight="480" Background="#F5F6F8"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="14" Foreground="#202A35" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#006B60"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#233540"/>
   <Setter Property="BorderBrush" Value="#D2DBDE"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,2,6,2"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#00776A"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".75"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Accent}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/>
   <Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DFE5E6"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Note" TargetType="TextBlock"><Setter Property="Foreground" Value="#50606B"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,8"/><Setter Property="BorderBrush" Value="#AAB9BD"/></Style>
  <Style TargetType="TabItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
   <Border x:Name="Tab" Background="Transparent" Margin="0,0,6,0" Padding="16,9" CornerRadius="7"><ContentPresenter x:Name="HeaderLabel" ContentSource="Header"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#DDEFEA"/><Setter TargetName="HeaderLabel" Property="TextElement.Foreground" Value="#005B50"/><Setter TargetName="HeaderLabel" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#006B60"/><Setter TargetName="Tab" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBox"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
 </Window.Resources>
 <DockPanel Margin="24,14,24,14">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Stay+" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
   <Border Grid.Column="1" Background="#E8EDEE" Padding="12,5" CornerRadius="14" VerticalAlignment="Center" MaxWidth="255">
    <TextBlock x:Name="Connection" Text="연결 확인 전" TextTrimming="CharacterEllipsis" FontSize="13"/></Border>
  </Grid>
  <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="9" Padding="14,9" Margin="0,8,0,0">
   <DockPanel><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="전송 취소" Click="Cancel" Visibility="Collapsed"/>
    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="Status" Text="차량을 연결하면 파일을 보낼 수 있습니다." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <ProgressBar x:Name="Progress" Visibility="Collapsed" Margin="0,7,8,0" Height="5" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}"/></StackPanel>
   </DockPanel>
  </Border>
  <TabControl x:Name="Pages" Background="Transparent" BorderThickness="0" Padding="0,14,0,0">
   <TabItem Header="내 파일"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,0,6,0">
    <Grid Margin="0,3,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="파일 보관함" FontWeight="SemiBold" FontSize="27"/><TextBlock Text="PC와 차량에서 주고받은 문서" Style="{StaticResource Note}"/></StackPanel>
     <Button Grid.Column="1" VerticalAlignment="Center" Content="＋  파일 올리기" Style="{StaticResource Primary}" Click="Upload"/>
    </Grid>
    <Border Style="{StaticResource Card}"><StackPanel>
     <DockPanel><Button DockPanel.Dock="Right" Content="새로 고침" Click="Refresh"/><TextBlock Text="파일 목록" Style="{StaticResource Heading}" VerticalAlignment="Center"/></DockPanel>
     <Border x:Name="Empty" Background="#F3F7F6" CornerRadius="8" Margin="0,10,0,0" Padding="18">
            <DockPanel>
       <Viewbox DockPanel.Dock="Right" Width="85" Height="70" Margin="12,0,2,0" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False">
        <Canvas Width="90" Height="72">
         <Border Canvas.Left="23" Canvas.Top="8" Width="49" Height="54" CornerRadius="6" Background="#B6DCD3" RenderTransformOrigin=".5,.5"><Border.RenderTransform><RotateTransform Angle="12"/></Border.RenderTransform></Border>
         <Border Canvas.Left="13" Canvas.Top="13" Width="46" Height="53" CornerRadius="6" Background="White" BorderBrush="#599D90" BorderThickness="1.5"/>
         <Path Stroke="#3A877A" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M22,27 H48 M22,35 H43 M22,43 H34"/>
         <Ellipse Canvas.Left="49" Canvas.Top="41" Width="24" Height="24" Fill="#006B60"/>
         <Path Stroke="White" StrokeThickness="2" Data="M55,53 H67 M61,47 V59"/>
        </Canvas>
       </Viewbox>
       <StackPanel><TextBlock x:Name="EmptyTitle" Text="차량과 파일을 공유하세요" FontWeight="SemiBold"/>
       <TextBlock x:Name="EmptyNote" Text="차량을 연결하면 이곳에서 원본과 수정본을 확인할 수 있습니다." Style="{StaticResource Note}"/>
       <Button x:Name="LinkShortcut" Content="차량 연결하기" HorizontalAlignment="Left" Click="ShowVehicles"/></StackPanel></DockPanel>
     </Border>
     <ListBox x:Name="Files" MaxHeight="235" Margin="0,8,0,0" SelectionChanged="SelectFile" AutomationProperties.Name="파일 목록">
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Background="#E4F2EE" CornerRadius="5" Padding="4" VerticalAlignment="Center"><TextBlock Text="{Binding Type}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#005B50" FontSize="12"/></Border>
       <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Date}" FontSize="12" Foreground="#50606B"/></StackPanel>
       <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="전송 완료" FontSize="12" Foreground="#006355"/>
      </Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="버전 기록" Style="{StaticResource Heading}"/>
     <TextBlock x:Name="VersionNote" Text="파일을 선택하면 원본과 수정본을 확인할 수 있습니다." Style="{StaticResource Note}"/>
     <ListBox x:Name="Versions" MaxHeight="155" DisplayMemberPath="Label" AutomationProperties.Name="파일 버전" SelectionChanged="SelectVersion"/>
     <WrapPanel><Button x:Name="SaveVersion" Content="선택한 버전 다운로드" Click="Download" IsEnabled="False"/>
      <Button x:Name="RemoveFile" Content="파일 삭제" Foreground="#953B36" Click="DeleteFile" IsEnabled="False"/></WrapPanel>
    </StackPanel></Border>
    <Expander Header="중단된 업로드 관리" Padding="3"><WrapPanel Margin="0,8"><Button Content="업로드 다시 시도" Click="RetryUpload"/><Button Content="재시도 기록 지우기" Click="DiscardUpload"/></WrapPanel></Expander>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem x:Name="Vehicles" Header="차량 연결"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,0,6,0">
    <TextBlock Text="차량 연결" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="VehicleTitle" Text="연결 상태 확인" Style="{StaticResource Heading}"/>
     <TextBlock x:Name="VehicleNote" Text="전에 연결한 차량이 있다면 연결을 복원하세요." Style="{StaticResource Note}"/>
     <WrapPanel><Button Content="연결 확인 · 복원" Click="Connect"/><Button x:Name="Unlink" Content="연결 해제" Click="Disconnect" IsEnabled="False"/></WrapPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="새 차량 연결" Style="{StaticResource Heading}"/>
     <TextBlock Text="차량의 파일 작업에서 PC 연결하기를 누른 뒤, 표시된 8자리 코드를 입력하세요." Style="{StaticResource Note}"/>
     <WrapPanel VerticalAlignment="Center"><TextBox x:Name="Code" Width="148" MaxLength="8" FontSize="19" AutomationProperties.Name="8자리 연결 코드" Margin="0,2,10,2"/>
      <Button Content="연결 요청" Click="Claim" Style="{StaticResource Primary}"/></WrapPanel>
     <Separator Margin="0,16"/><TextBlock x:Name="PairNote" Text="코드 확인 후 PC와 차량에서 각각 승인하세요." Style="{StaticResource Note}"/>
     <WrapPanel><Button Content="상태 새로고침" Click="PairStatus"/><Button x:Name="ApproveVehicle" Content="이 차량 승인" Click="Approve" IsEnabled="False" Style="{StaticResource Primary}"/></WrapPanel>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="설정"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,0,6,0">
    <TextBlock Text="설정" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="파일 전송" Style="{StaticResource Heading}"/>
     <TextBlock Text="TXT, PDF, DOCX 문서를 파일당 최대 20 MiB까지 보낼 수 있습니다. 수정본은 원본과 별도 버전으로 보관합니다." Style="{StaticResource Note}"/></StackPanel></Border>
    <Border x:Name="DeveloperConfiguration" Style="{StaticResource Card}"><Expander Header="개발자 설정"><StackPanel Margin="0,14,0,0">
     <TextBlock Text="전송 서버 주소"/><TextBox x:Name="Server" AutomationProperties.Name="전송 서버 주소"/>
     <TextBlock Text="Supabase URL"/><TextBox x:Name="AuthUrl" AutomationProperties.Name="Supabase URL"/>
     <TextBlock Text="공개 키 (publishable key)"/><TextBox x:Name="PublicKey" AutomationProperties.Name="공개 키"/>
     <CheckBox x:Name="LocalMode" Content="로컬 테스트 인증 사용 (LOCAL FAKE)" Margin="0,7"/>
     <TextBlock Text="로컬 PC 테스트 토큰"/><PasswordBox x:Name="Token" Padding="8,5" Margin="0,4,0,8" AutomationProperties.Name="로컬 PC 테스트 토큰"/>
     <Button Content="설정 적용 및 연결 확인" Click="Connect" HorizontalAlignment="Left"/>
     <Button Content="PC에서 코드 발급" Click="Issue" HorizontalAlignment="Left"/>
    </StackPanel></Expander></Border>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel>
</Window>
