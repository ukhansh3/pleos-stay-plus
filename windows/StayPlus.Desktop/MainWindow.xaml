<Window x:Class="StayPlus.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Stay+ — FileTransfer" Width="800" Height="700">
 <ScrollViewer><StackPanel Margin="24">
 <TextBlock FontSize="24" Text="Stay+"/><TextBlock Text="수동 문서 전송 · 원본 보존 · 수정본 별도 버전"/>
 <CheckBox x:Name="LocalMode" Content="LOCAL FAKE 테스트 모드" IsChecked="True"/>
 <TextBlock Text="Supabase URL (운영 인증 모드)"/><TextBox x:Name="AuthUrl"/>
 <TextBlock Text="Supabase publishable key"/><TextBox x:Name="PublicKey"/>
 <TextBlock Text="서버 주소"/><TextBox x:Name="Server" Text="http://127.0.0.1:3010/api/v1/realtime/"/>
 <TextBlock Text="로컬 PC 테스트 토큰 (서버 설정과 동일)"/><PasswordBox x:Name="Token"/>
 <Button Content="등록 / 연결 복원" Click="Connect"/>
 <WrapPanel><Button Content="코드 발급" Click="Issue" Margin="4"/><TextBox x:Name="Code" Width="130" Margin="4"/><Button Content="코드 입력" Click="Claim" Margin="4"/><Button Content="상대 확인" Click="PairStatus" Margin="4"/><Button Content="상대 승인" Click="Approve" Margin="4"/><Button Content="연결 해제" Click="Disconnect" Margin="4"/></WrapPanel>
 <TextBlock x:Name="Connection" TextWrapping="Wrap"/>
 <Button Content="파일 목록 새로고침" Click="Refresh"/>
 <ListBox x:Name="Files" Height="150" DisplayMemberPath="Label" SelectionChanged="SelectFile"/>
 <ListBox x:Name="Versions" Height="100" DisplayMemberPath="Label"/>
 <WrapPanel><Button Content="문서 원본 선택·업로드" Click="Upload" Margin="4"/><Button Content="선택 버전 다운로드" Click="Download" Margin="4"/><Button Content="선택 문서 전체 삭제" Click="DeleteFile" Margin="4"/><Button Content="중단 전송 복구·재시도" Click="RetryUpload" Margin="4"/><Button Content="복구 기록 지우기" Click="DiscardUpload" Margin="4"/><Button Content="전송 취소" Click="Cancel" Margin="4"/></WrapPanel>
 <ProgressBar x:Name="Progress" Height="18" Minimum="0" Maximum="100"/>
 <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,12"/>
 </StackPanel></ScrollViewer>
</Window>

