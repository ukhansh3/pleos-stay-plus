NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=your_kakao_javascript_key
# Server-only fixed proxy target. HTTPS is required outside loopback.
PICKUP_BACKEND_URL=http://127.0.0.1:3000/api/v1
# Server-only development gate. Never enable on a public tunnel or production host.
ENABLE_PICKUP_SIMULATOR=false
# Server-only random value, at least 32 characters. Must match the backend.
PICKUP_SIMULATOR_TOKEN=replace_with_a_random_development_only_value
