# Example variable names only; never commit real secrets.
# Supabase connection. Secret key is backend-only; never expose it through NEXT_PUBLIC_*.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_backend_secret_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=your_kakao_javascript_key
PUBLIC_WEB_BASE_URL=http://localhost:3001
PICKUP_API_BASE_URL=http://localhost:3000/api/v1
# Leave unset until measured and approved; automatic proximity remains disabled.
PICKUP_PROXIMITY_MAX_ACCURACY_METERS=
PICKUP_PROXIMITY_MAX_AGE_SECONDS=
PARKING_PROVIDER_API_KEY=
PARKING_PROVIDER_BASE_URL=https://api.data.go.kr/openapi/tn_pubr_prkplce_info_api
# Enable only after activating the official 전국휴게소정보표준데이터 API.
REST_AREA_PROVIDER_API_KEY=
REST_AREA_PROVIDER_BASE_URL=https://api.data.go.kr/openapi/tn_pubr_public_rest_area_api
PARKING_CACHE_TTL_HOURS=24
PARKING_STALE_MAX_DAYS=7
PARKING_API_PORT=3000
